# Copy to .env. AWS credentials come from the normal AWS credential chain
# (aws sso login / AWS_PROFILE / AWS_ACCESS_KEY_ID...), not from this file.
AWS_REGION=us-east-1
NOVA_SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0
NOVA_VOICE_ID=matthew
# Used for the "describe this photo" feature (Bedrock Converse).
VISION_MODEL_ID=us.amazon.nova-lite-v1:0
# Set to 1 to run without AWS (scripted fake voice conversation).
MOCK_VOICE=0
